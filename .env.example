# Runtime mode: backtest | paper | demo | live
TRADING_MODE=paper
TRADING_CONFIG_DIR=configs
TRADING_CONFIG_BASE=base.yaml
# bybit_demo = Bybit demo (api-demo.bybit.com), preferred for demo
# bybit_testnet = Bybit testnet
# bybit_mainnet = live mainnet
TRADING_ENV=bybit_testnet

# dry_run=true = no exchange orders (default for demo/live)
# dry_run=false = orders sent to exchange
TRADING_DRY_RUN=true

# Comma-separated symbols (must exist in configs/symbols.yaml)
TRADING_SYMBOLS=BTCUSDT

BYBIT_API_KEY=
BYBIT_API_SECRET=

# Optional: backtest bar count when TRADING_MODE=backtest (default: 350)
# TRADING_BACKTEST_BARS=350

# Optional: storage (when unset, Postgres is skipped, Parquet uses data/archive)
# TRADING_POSTGRES_DSN=postgresql://user:pass@localhost:5432/trading
TRADING_ARCHIVE_DIR=data/archive

# Optional overrides
TRADING_LOG_LEVEL=INFO
TRADING_LOG_JSON=true
